{
  "name": "google-forms-mcp",
  "version": "0.1.0",
  "description": "MCP server for Google Forms integration",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', '755')\"",
    "start": "node build/index.js",
    "build:token": "tsc -p tsconfig.json",
    "get-refresh-token": "npm run build:token && node build/get-refresh-token.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.19.0",
    "googleapis": "^176.0.0",
    "open": "^11.0.1",
    "server-destroy": "^1.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/server-destroy": "^1.0.4",
    "typescript": "^5.9.3",
    "undici-types": "^7.29.0"
  }
}
